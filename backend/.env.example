# Copier en .env et adapter.
# "production" active des garde-fous : le serveur refuse de démarrer avec un réglage dangereux.
RESERVA_ENV=dev

# Envoi des codes « mot de passe oublié ». SMS : la passerelle RESERVA_SMS_* plus bas. E-mail : SMTP.
RESERVA_SMTP_HOST=
RESERVA_SMTP_PORT=587
RESERVA_SMTP_USER=
RESERVA_SMTP_PASSWORD=
RESERVA_SMTP_FROM=
RESERVA_DEFAULT_COUNTRY_CODE=237
RESERVA_DATA_DIR=data
RESERVA_PUBLIC_BASE_URL=http://localhost:8000
RESERVA_CORS_ORIGINS=["http://localhost:5173"]

# Sécurité : générer avec  python -c "import secrets; print(secrets.token_urlsafe(48))"
RESERVA_SECRET_KEY=
# Secret partagé avec le serveur de paiement (webhook Mobile Money). Vide = recharge désactivée.
RESERVA_BILLING_SECRET=

# Administrateurs de la plateforme (identifiants de connexion : téléphone en chiffres, ou e-mail)
RESERVA_ADMIN_LOGINS=["690000000"]

# Paiement Mobile Money (TrustChange). Sans clé, le paiement en ligne est inactif.
RESERVA_TRUSTCHANGE_API_KEY=
RESERVA_TRUSTCHANGE_WEBHOOK_SECRET=
# Adresse publique du webhook, à déclarer aussi chez TrustChange
RESERVA_TRUSTCHANGE_CALLBACK_URL=https://votre-domaine/api/payments/webhook
# Noms des en-têtes du webhook : à vérifier dans la documentation TrustChange
RESERVA_TRUSTCHANGE_SIGNATURE_HEADER=X-TrustChange-Signature
RESERVA_TRUSTCHANGE_TIMESTAMP_HEADER=X-TrustChange-Timestamp
# Développement uniquement : sans clé, tout paiement réussit aussitôt. Jamais en production.
RESERVA_PAYMENT_SIMULATION=false
RESERVA_TRIAL_DAYS=14
RESERVA_TOPUP_MIN_FCFA=500

# Tarifs IA : prix du fournisseur (à vérifier chez lui), taux de change, marge, crédit de bienvenue
RESERVA_AI_USD_PER_MTOK_IN=0.15
RESERVA_AI_USD_PER_MTOK_OUT=0.60
RESERVA_AI_USD_PER_AUDIO_MIN=0.006
RESERVA_USD_TO_FCFA=600
RESERVA_AI_MARGIN_PCT=30
RESERVA_WELCOME_CREDIT_FCFA=500

# IA : rules (hors ligne, sans clé) | openai (tout serveur compatible OpenAI)
RESERVA_AI_PROVIDER=rules
RESERVA_AI_BASE_URL=https://api.openai.com/v1
RESERVA_AI_API_KEY=
RESERVA_AI_LLM_MODEL=gpt-4o-mini
RESERVA_AI_ASR_MODEL=whisper-1
# Modèle qui décrit un défaut à partir de sa seule photo (vide = désactivé). Exemples de réglages :
#   OpenAI  : RESERVA_AI_BASE_URL=https://api.openai.com/v1, modèles gpt-4o-mini (texte et photos)
#   Mistral : RESERVA_AI_BASE_URL=https://api.mistral.ai/v1, mistral-small-latest, photos pixtral-12b-latest
#   Gemini  : RESERVA_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, gemini-2.0-flash
# Vérifiez les noms de modèles chez le fournisseur : ils changent.
RESERVA_AI_VISION_MODEL=

# Envoi : console (simulé) | whatsapp (Cloud API Meta) | sms (passerelle HTTP)
RESERVA_DISPATCH_CHANNEL=console
RESERVA_WHATSAPP_TOKEN=
RESERVA_WHATSAPP_PHONE_NUMBER_ID=
RESERVA_SMS_GATEWAY_URL=
RESERVA_SMS_API_KEY=
RESERVA_SMS_SENDER=RESERVA
